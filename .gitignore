# Exclude private inputs, engine caches and exports. Explicit reviewed runtime assets are tracked.
__pycache__/
*.py[cod]
.godot/
.runtime*/
.env
.env.*
*.pem
*.key
*.zip
*.7z
*.tar
*.tar.gz
*.part[0-9][0-9][0-9]
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.mov
*.exe
*.dll
*.pck
**/evidence*/
**/generated/
**/compiled*/
**/checkpoints/
**/cache/

# Standalone runtime contains essential authored/generated geometry.
!godot/
!godot/riverstone_city/
!godot/riverstone_city/**
godot/riverstone_city/.godot/
godot/riverstone_city/**/__pycache__/

# The runtime exception never authorizes secrets, pictures, exports or editor caches.
.env
.env.*
*.pem
*.key
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.mov
*.exe
*.dll
*.pck
*.zip
*.7z
.godot/
__pycache__/
