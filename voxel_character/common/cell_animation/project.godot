config_version=5

[application]
config/name="Common Voxel · Fixed Cell Pools"
run/main_scene="res://Preview.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=960
window/size/window_width_override=1120
window/size/window_height_override=840
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.90,0.91,0.92,1)

[editor]
movie_writer/fps=30
