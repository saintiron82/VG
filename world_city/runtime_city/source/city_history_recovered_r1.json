    "stone_palette_family": "gray_stone_r4",
    "palette_reference_policy": "semantic aliases; resolve existing r4 materials, do not invent replacement hex values",
    "era_assignment": "sample declared era_mix using stable footprint ID; spatially cluster surviving/rebuilt fabric where verified features permit",
    "floor_policy": "honor supplied footprint height when present; use archetype range only for new ordinary massing",
    "style_transition": "blend through age wealth and function at district edges; no abrupt palette change",
    "street_rule": "existing road geometry is authoritative; history explains bends, never straightens them",
    "fire_scope": "localized_market_frontage; not citywide_destruction; do not mark every market plot rebuilt",
    "roof_weathering": "subtle_shared_palette_variation_with_age_and_exposure; never random_rainbow",
    "roof_material_note": "Muted teal is an intentional art-direction palette, not a historical claim that all roofs were copper.",
    "utility_constraint": "Respect source U_MILL_POWER: D06-B052 is inland animal/manual milling, not an invented watermill. U_DRAINAGE gradients and drinking-water quality remain unverified.",
    "guild_constraint": "Commercial and craft communal functions need not imply autonomous guild government; do not add separate guild fortresses.",
    "procedural_variation_contract": {
      "seed_source": "city_brief.seed + stable_building_id",
      "era_mix_scope": "weighted_design_priors_not_historical_statistics",
      "floor_counts_exclude": "attic_and_roof",
      "roof_pitch_scope": "design_ranges_for_new_ordinary_roofs_only",
      "discrete_cache_key": [
        "archetype",
        "era_id",
        "floor_count",
        "roof_form",
        "facade_module",
        "palette_alias"
      ],
      "orientation": "instance_transform_from_existing_plot_and_access_edge",
